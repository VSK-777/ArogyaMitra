# ==========================================
# AROGYAMITRA - ENV VARIABLES
# ==========================================

# ------------------------------------------
# FRONTEND CONFIGURATION
# ------------------------------------------
# The base URL of the Spring Boot Backend API
VITE_API_BASE_URL=http://localhost:8080

# ------------------------------------------
# BACKEND SERVER CONFIGURATION
# ------------------------------------------
# Port for the Spring Boot application (default: 8080)
PORT=8080

# Demo mode flag (true/false) - If true, disables certain destructive actions
DEMO_MODE=false

# ------------------------------------------
# DATABASE CONFIGURATION (Neon / PostgreSQL)
# ------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/hospital_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ------------------------------------------
# SECURITY
# ------------------------------------------
# Secret key used for signing JWT tokens (should be a long random string)
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long

# ------------------------------------------
# SUPABASE STORAGE CONFIGURATION
# ------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> Storage -> S3 Access Keys
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_ACCESS_KEY=
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=hospital-medical-documents

# ------------------------------------------
# ------------------------------------------

# ------------------------------------------
# AI CONFIGURATION
# ------------------------------------------
# Your Google Gemini API Key (Supports multiple keys separated by commas for round-robin rate limit bypassing)
GEMINI_API_KEY=key_1,key_2,key_3

# URL of the Python AI Microservice
# Local default: http://localhost:8000
# Docker compose default: http://python-ai:8000
# Cloud deployment default: https://sih-python-ai.onrender.com
PYTHON_AI_URL=http://localhost:8000
